{
  "name": "discord-dashboard-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "build": "pnpm --filter dashboard build && pnpm --filter bot build",
    "start": "pnpm --filter dashboard start & pnpm --filter bot start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "bot:deploy": "pnpm --filter bot deploy",
    "bot:dev": "pnpm --filter bot dev",
    "bot:start": "pnpm --filter bot start"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  }
}
